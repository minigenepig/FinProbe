{
  "$id": "https://finprobe.local/contracts/investigation.schema.json",
  "title": "InvestigationSnapshot",
  "type": "object",
  "required": [
    "id",
    "status",
    "eventSeq",
    "question",
    "wantReport",
    "mode",
    "scope",
    "subject",
    "agents",
    "skills",
    "reason",
    "clarifyQuestion",
    "answer",
    "envelopes",
    "evidenceReview",
    "report",
    "followUpRound",
    "overallRiskLevel",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^INVST-" },
    "status": { "type": "string" },
    "eventSeq": { "type": "integer", "minimum": 0 },
    "question": { "type": "string" },
    "wantReport": { "type": "boolean" },
    "mode": { "type": ["string", "null"] },
    "scope": { "type": ["string", "null"] },
    "subject": {
      "type": "object",
      "properties": {
        "supplierId": { "type": ["string", "null"] },
        "supplierName": { "type": ["string", "null"] },
        "poId": { "type": ["string", "null"] },
        "grId": { "type": ["string", "null"] },
        "invoiceId": { "type": ["string", "null"] },
        "paymentId": { "type": ["string", "null"] },
        "taxNo": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "agents": { "type": "array", "items": { "type": "string" } },
    "skills": { "type": "array", "items": { "type": "string" } },
    "reason": { "type": ["string", "null"] },
    "clarifyQuestion": { "type": ["string", "null"] },
    "answer": { "type": ["string", "null"] },
    "envelopes": { "type": "array", "items": { "type": "object" } },
    "evidenceReview": { "type": ["object", "null"] },
    "report": { "type": ["object", "null"] },
    "followUpRound": { "type": "integer", "minimum": 0, "maximum": 2 },
    "overallRiskLevel": { "type": ["string", "null"] },
    "messages": { "type": "array" },
    "error": { "type": ["object", "null"] },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}